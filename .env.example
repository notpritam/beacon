# Postgres connection string (Supabase project DB, or a local Postgres for dev).
BEACON_DATABASE_URL=postgres://postgres:beacon@localhost:5433/postgres
# Human label for this machine.
BEACON_MACHINE_NAME=my-mac
# Per-machine secret this machine presents for auth.
BEACON_MACHINE_TOKEN=change-me
# Bearer token the MCP server requires from callers (Wingman).
BEACON_WINGMAN_TOKEN=change-me
# Address the MCP server listens on (default :8080).
BEACON_MCP_ADDR=:8080
# Token gating the live-view dashboard. Empty (the default) disables the dashboard.
# When set, the agent serves a browser live view (screen stream + jobs feed) at /?token=...
BEACON_DASHBOARD_TOKEN=
# Address the dashboard listens on (default :8081). Only used when a token is set.
BEACON_DASHBOARD_ADDR=:8081
